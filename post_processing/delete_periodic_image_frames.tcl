proc delete_periodic_image_frames {data_dir processed_dir} {
    
 	#   Reads in a list of trajectory frames of the proteins periodic image. These frames should be deleted from the trajectory.
 	#   mindist was calculated using GROMACS and the frame associated with a value of 2nm or lower was put into a list generated by a python script
    #   The python script used to generate the list is called "delete_periodic_image_frames.py"
    #    
    #   Arguments:
    #       data_dir (str): Directory to output data
    #       processed_dir (str): Directory that contains the processed trajectories
    # 
    #   Returns:
    #       None
   
    set protein_name [molinfo top get name]
    set seq [string range $protein_name 0 2]
    puts $seq

 	# Set the file path and read the file
    set file_path "${data_dir}/${seq}_mindist_frames_to_delete.txt"
    set fp [open $file_path "r"]; # Open the file for reading
    set frame_to_delete [split [read $fp] "\n"]; # Read the numbers from the file
    close $fp

    # Convert the lines to a list of numbers
    set list_of_frames {} 
    foreach frame $frame_to_delete {
        if {[string length $frame] > 0} {
            lappend list_of_frames [expr {double($frame)}]
        }
    }

    # Sort the numbers from largest to smallest
    set sorted_unwanted_frames_list [lsort -real $list_of_frames]
    
    # Get the length of the sorted list for the for loop
    set len_unwanted_frames_list [llength $sorted_unwanted_frames_list]
    
    # Delete frames starting from the last frame
    for {set i [expr $len_unwanted_frames_list - 1]} {$i >= 0} {incr i -1} {
        set frame_to_be_deleted [lindex $sorted_unwanted_frames_list $i]
        animate delete beg $frame_to_be_deleted end $frame_to_be_deleted
    }

    # Write output
    set structureName [molinfo top get name] 
    set seq [string index $structureName 0] 
    animate write gro "${processed_dir}/${seq}66_wrapped_centered_PIF_del.gro" beg 0 end -1 top
}
